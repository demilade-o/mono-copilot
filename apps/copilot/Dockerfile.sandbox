FROM python:3.12-slim

ARG BUN_VERSION=1.3.14

# Base tools
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       bash curl ca-certificates unzip xz-utils git \
    && rm -rf /var/lib/apt/lists/*

# Install uv into /usr/local/bin
RUN curl -LsSf https://astral.sh/uv/install.sh | \
    UV_UNMANAGED_INSTALL=/usr/local/bin UV_NO_MODIFY_PATH=1 sh

# Install bun by downloading the release binary directly
RUN curl -fsSL -o /tmp/bun.zip \
      https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/bun-linux-x64.zip \
    && unzip -q /tmp/bun.zip -d /tmp/bun \
    && mv /tmp/bun/*/bun /usr/local/bin/bun \
    && chmod +x /usr/local/bin/bun \
    && rm -rf /tmp/bun /tmp/bun.zip

# Verify all three runtimes are present
RUN uv --version && bun --version && python --version

# Create the non-root user and workspace the agent runs in
RUN groupadd --gid 65532 nonroot \
    && useradd --uid 65532 --gid 65532 --create-home --shell /bin/bash nonroot \
    && mkdir -p /workspace \
    && chown -R nonroot:nonroot /workspace

WORKDIR /workspace
USER nonroot